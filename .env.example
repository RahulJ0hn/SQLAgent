# AWS Bedrock
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# PostgreSQL (for cloud deployment, set DATABASE_URL; for local Docker, use individual params)
DATABASE_URL=
PG_HOST=postgres
PG_PORT=5432
PG_USER=sqlagent
PG_PASSWORD=sqlagent_dev
PG_DATABASE=retaildb

# ChromaDB ("embedded" for cloud, "http" for Docker)
CHROMA_MODE=embedded
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Agent
AGENT_PORT=8080

# Orchestrator
PORT=3000
AGENT_URL=http://localhost:8080
CLIENT_URL=http://localhost:5173

# Client (set in Vercel env vars)
# VITE_API_URL=https://your-orchestrator.onrender.com/api
